# Set default behavior to automatically handle line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout, but commit with LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

# Windows scripts must keep CRLF to execute properly
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix shell scripts must always have LF
*.sh text eol=lf

# Denote all binary files to ensure Git does not modify them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.zip binary
*.tar.gz binary
*.pyc binary
