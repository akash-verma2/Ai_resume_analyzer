{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start AI Microservice (Python FastAPI)",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/ai-service"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "reveal": "always"
      }
    },
    {
      "label": "2. Start Backend API Gateway (Express)",
      "type": "shell",
      "command": "node server.js",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "reveal": "always"
      }
    },
    {
      "label": "3. Start Frontend Client (React Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "reveal": "always"
      }
    },
    {
      "label": "Start All Services (AI + Backend + Frontend)",
      "dependsOn": [
        "1. Start AI Microservice (Python FastAPI)",
        "2. Start Backend API Gateway (Express)",
        "3. Start Frontend Client (React Vite)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
